# GEMINI_API_KEY: Required for Gemini AI API calls (Primary LLM Router).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# GROQ_API_KEY: Secondary backup LLM router for fast failovers.
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"

# TELEGRAM_BOT_TOKEN: Telegram bot token for critical trade/risk notifications.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# TELEGRAM_CHAT_ID: Chat ID to deliver alerts to the user.
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID_HERE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
